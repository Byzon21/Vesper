{
    "name": "byzon21/vesper",
    "description": "Vesper — PWA ultra-sécurisée de gestion de dépenses financières personnelles et de couple (mobile-first).",
    "type": "project",
    "license": "proprietary",
    "keywords": ["pwa", "finance", "budget", "couple", "supabase", "security"],
    "require": {
        "php": "^8.3",
        "ext-sodium": "*",
        "ext-openssl": "*",
        "ext-bcmath": "*",
        "laravel/framework": "^12.0",
        "livewire/livewire": "^3.5",
        "guzzlehttp/guzzle": "^7.8",
        "firebase/php-jwt": "^7.0",
        "paragonie/sodium_compat": "^2.0",
        "barryvdh/laravel-dompdf": "^3.0",
        "rubix/ml": "^2.5",
        "posthog/posthog-php": "^4.0",
        "laravel/sanctum": "^4.0"
    },
    "require-dev": {},
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
