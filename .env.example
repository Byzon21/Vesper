# ==========================================================================
# Vesper — Modèle d'environnement (.env.example)
# ⚠️  NE JAMAIS versionner le vrai .env. Les valeurs réelles proviennent du
#     VAULT (HashiCorp Vault en production / fichier chiffré AES-256-GCM en
#     développement). Ce fichier ne contient AUCUN secret réel.
# ==========================================================================

APP_NAME="Vesper"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost

# --- Vault (Secrets Management centralisé) ---
# Driver: "local" (fichier chiffré dev) ou "hashicorp" (production)
VAULT_DRIVER=local
# Local : chemin du fichier chiffré + clé maîtresse (elle-même issue de l'env de CI/KMS)
VAULT_LOCAL_FILE=/storage/secure/vault.enc
# Hachicorp Vault : adresse, rôle AppRole, token éphémère
VAULT_ADDR=https://vault.internal:8200
VAULT_APPROLE_ROLE_ID=
VAULT_APPROLE_SECRET_ID=
VAULT_TOKEN_TTL=300

# --- Supabase (PostgreSQL + Auth + Storage) ---
# URL & JWKS dérivés du Project Ref : https://<ref>.supabase.co
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
# Clé SECRÈTE (sb_secret_...) — équivalent service_role, BYPASS RLS. Vault en prod.
SUPABASE_SERVICE_ROLE_KEY=
# Clé PUBLISHABLE (sb_publishable_...) — publique, côté client.
SUPABASE_ANON_KEY=
# Exposées au frontend (Vite) — clé publishable (publique).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Chiffrement applicatif (Field-Level Encryption) ---
# Algorithme: AES-256-GCM. Les DEK/KEK vivent dans le Vault, jamais ici.
CIPHER_ALGO=aes-256-gcm
KDF_ALGO=argon2id
KDF_OPSLIMIT=4
KDF_MEMLIMIT=67108864

# --- Intégrité des requêtes (anti-phishing / anti-bot) ---
HMAC_SECRET_ID=vesper/hmac/signing-key
HMAC_TOLERANCE_SECONDS=300

# --- Sécurité HTTP ---
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=true
SESSION_SAME_SITE=lax
HSTS_ENABLE=true
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# --- Taux de change (provider, clé via Vault) ---
FX_PROVIDER=openexchangerates
FX_PROVIDER_SECRET_ID=vesper/fx/openexchangerates
FX_CACHE_TTL_MINUTES=60

# --- Analytics (PostHog) ---
POSTHOG_ENABLED=true
POSTHOG_HOST=https://us.i.posthog.com
# Clé PROJET publique (phc_) — exposée côté client, conçue pour être publique.
VITE_POSTHOG_KEY=
# Clé projet côté serveur (capture d'événements backend) — injectée par le Vault/secret manager en prod.
POSTHOG_PROJECT_TOKEN=
# Clé PERSONNELLE (phx_) — SECRET strict (admin API), résolue via Vault, JAMAIS ici en prod.
POSTHOG_PERSONAL_KEY_VAULT=vesper/posthog/personal_api_key
# Dev uniquement : clé personnelle directe (remplacée par le Vault en production).
POSTHOG_PERSONAL_API_KEY=

# --- ML (Rubix ML) ---
ML_MODEL_PATH=/storage/app/ml/models
ML_ENABLED=true

# --- Divers ---
LOG_CHANNEL=stack
QUEUE_CONNECTION=database
